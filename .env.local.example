# Hosted Supabase project (Project Settings → API). Copy to .env.local.
# Used by `next build` / production, and by `next dev` when there is no
# .env.development.local.
#
# For local dev against the local stack instead, run:
#   npm run db:start && npm run db:env
# which writes .env.development.local (dev only, takes precedence over this).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
