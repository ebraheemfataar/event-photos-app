# Hosted Supabase project. Copy to .env.local.
# Used by `next build` / production, and by `next dev` when there is no
# .env.development.local.
#
# For local dev against the local stack instead, run:
#   npm run db:start && npm run db:env
# which writes .env.development.local (dev only, takes precedence over this).

# Public — shipped to the browser. Project Settings → API (anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only, never prefix with NEXT_PUBLIC_. Project Settings → API
# (service_role / secret key). Bypasses RLS; used for all reads since
# 0007_lock_down_reads.sql. On Vercel, add it as a Sensitive variable.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — server only. Any long random string; Vercel Cron sends it to
# /api/cron/expire as "Authorization: Bearer <CRON_SECRET>". On Vercel, add it
# as a Sensitive variable. Without it the expiry job refuses every call.
CRON_SECRET=

# Off unless set to "true": the expiry job only REPORTS albums past their
# deletion date. Turn on when pricing launches.
EXPIRY_DELETE_ENABLED=

# SECRET — server only. The admin portal (/admin) password: 12+ characters,
# long and random (use a password manager). On Vercel, add it as a Sensitive
# variable. Without it /admin stays switched off. Changing it signs out
# every admin session.
ADMIN_PASSWORD=

# PayFast (Monetisation B). Payments stay OFF unless MERCHANT_ID and
# MERCHANT_KEY are set. Merchant key and passphrase are SECRETS (Sensitive on
# Vercel). PAYFAST_SANDBOX=true uses PayFast's sandbox. Never set
# PAYFAST_SKIP_REMOTE_CHECKS in production (it's ignored there anyway).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=

# "true" turns on the guest cap (new guests beyond the plan's limit are
# turned away). Leave unset until pricing launches.
PLAN_LIMITS_ENFORCED=

# Email receipts via Resend (optional; without these, no emails are sent).
RESEND_API_KEY=
EMAIL_FROM=
