# Hosted Supabase project. Copy to .env.local.
# Used by `next build` / production, and by `next dev` when there is no
# .env.development.local.
#
# For local dev against the local stack instead, run:
#   npm run db:start && npm run db:env
# which writes .env.development.local (dev only, takes precedence over this).

# Public — shipped to the browser. Project Settings → API (anon / publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only, never prefix with NEXT_PUBLIC_. Project Settings → API
# (service_role / secret key). Bypasses RLS; used for all reads since
# 0007_lock_down_reads.sql. On Vercel, add it as a Sensitive variable.
SUPABASE_SERVICE_ROLE_KEY=
